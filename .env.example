# UPMIND Environment Configuration Example
# Copy this file to .env or pass these as --dart-define parameters during build

# Client Configuration (Safe for Flutter client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Configuration (Set in Supabase Dashboard / Edge Functions - NEVER embed in client APK)
# GEMINI_API_KEY=your-gemini-api-key
